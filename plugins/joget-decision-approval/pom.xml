<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fiscaladmin.joget</groupId>
        <artifactId>joget-platform-plugins</artifactId>
        <version>1.0.0</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>joget-decision-approval</artifactId>
    <!-- 1.3.0 (METHOD-2026-10-16-01; MT-DM's request of 15 October 2026): RequesterWithheld, a
         permission on a form element that withholds an act from the record's requester. A minor
         step: a new plugin; the service, the gate and the route engine read as before.
         1.3.1 (METHOD-2026-10-17-05, version 2): RequesterWithheld compiled against jakarta.servlet,
         which Joget 9 serves; 1.3.0 named Joget 8's servlet API, and Tomcat's jakartaee migration rewrote the
         placed jar at its first start, to an import Felix's unversioned export does not satisfy. The
         request is read through WorkflowUtil by name, so the bytes name jakarta.servlet alone, and the
         import carries no version range. A patch step: nothing a configuration says reads otherwise.
         1.4.0 (METHOD-2026-11-05-45; MT-DM's hand-off of 8 November 2026, item 46): every row the
         service and its engines save carries the columns the platform fills when it saves a form's
         row, by the rule of AppServiceImpl.storeFormData (Joget 9.0.7, lines 2161-2196): a new
         approval request takes dateCreated, dateModified and the who-columns; every row they load,
         change and save (the record's level and result and the saved act's result by
         ApprovalRouteEngine; the approval, the decision, the gate, sweep and delegate records and the
         authority check) takes dateModified and modifiedBy / modifiedByName, its created three kept
         as loaded and filled only where the row holds no dateCreated. A minor step: no key added,
         nothing a configuration says reads otherwise; the engines gain a package-private run()
         for their tests.
         1.5.0 (METHOD-2026-11-05-51, R34; MT-DM's answer of 8 November 2026 to item 46's acceptance):
         the events the service and the decision service append through joget-event-chain 2.1.0 are
         stamped as the platform stamps a row, and each is handed the move's own moment (the `now`
         the move is called with, or `asOf` for the sweep) as its instant, including the status
         event the service's terminal move appends through joget-status-manager 2.1.0. The pins of
         both move to 2.1.0. A minor step: no key added; nothing a configuration says reads
         otherwise.
         1.6.0 (METHOD-2026-11-05-67, R40; MT-DM's request of 9 November 2026, H3, and the two clock
         readings the review of R36 left): every plugin class of the bundle reports the bundle's
         version (RequesterWithheld read 1.3.1 and ApprovalInboxBinder 1.0.0 in the instance's plugin
         list), held for every class by EveryClassReportsItsBundleVersionTest; the service looks the
         authority matrix up at the day the move is handed (the request's now, the sweep's asOf, the
         route engine's one reading) and no longer at the clock's day; the route engine and the
         authority-matrix engine read the clock once and save every row they write on that reading.
         A minor step: no key added; nothing a configuration says reads otherwise.
         1.6.1 (METHOD-2026-11-05-79, R46; the act R40's G2 left): the route engine hands the transition guard its one
         reading as the property moveMoment and saves the record on that same instant, so the record, the act, the
         guard's history entries and the status event of a routed move are one instant (the guard 1.11.0 takes it;
         an earlier guard ignores it). The bundle still imports nothing of the guard's: the guard is a test-scope
         dependency, so the cases run the real guard. A patch step: no key added; nothing a configuration says reads
         otherwise. -->
    <version>1.6.1</version>
    <packaging>bundle</packaging>
    <name>joget-decision-approval</name>
    <description>Configurable decision &amp; approval service for Joget DX: authority-matrix
        routing (rank/quorum), reasoned-grounds enforcement and audited decisions. Ships the
        DecisionEffect SPI + a static DecisionEffects registry so the effect run on approval is
        supplied by the consumer (the platform never names a domain service — the inversion).
        Library bundle (exports com.fiscaladmin.joget.approval); depends on joget-status-manager
        and joget-event-chain and the Joget form/commons API only.</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-Activator>com.fiscaladmin.joget.approval.Activator</Bundle-Activator>
                        <Export-Package>com.fiscaladmin.joget.approval</Export-Package>
                        <Import-Package>com.fiscaladmin.joget.eventchain,com.fiscaladmin.joget.statusmanager,org.joget.apps.app.service,org.joget.apps.datalist.model,org.joget.apps.form.dao,org.joget.apps.form.model,org.joget.commons.util,org.joget.plugin.base,org.joget.workflow.util,org.osgi.framework,jakarta.servlet.http;version="0",*</Import-Package>
                        <DynamicImport-Package>*</DynamicImport-Package>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>com.fiscaladmin.joget</groupId>
            <artifactId>joget-event-chain</artifactId>
            <version>2.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fiscaladmin.joget</groupId>
            <artifactId>joget-status-manager</artifactId>
            <version>2.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.joget</groupId>
            <artifactId>wflow-core</artifactId>
        </dependency>
        <!-- 1.3.0: RequesterWithheld reads the record's key from the request.
             1.3.1: from jakarta.servlet, which Joget 9 serves (Joget 8's servlet API before). -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- 1.6.1: the cases of the route engine run the real transition guard (test scope only; the bundle imports
             nothing of the guard's and its manifest is unchanged) -->
        <dependency>
            <groupId>com.fiscaladmin.joget</groupId>
            <artifactId>joget-transition-guard</artifactId>
            <version>1.12.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>
    </dependencies>
</project>
